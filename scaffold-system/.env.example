# 复制为同目录 .env；真实密码和签名密钥只保存到 .env。
# 每行使用 变量名=值，可用成对单引号或双引号包裹值，不执行变量展开。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scaffold_system
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+08:00
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 独立 Redis 实例可用0；共享实例请选空闲逻辑库，并确认该编号可用。
REDIS_DATABASE=0
JWT_SECRET=
SERVER_PORT=8080
